<%- include('../partials/breadcrumb', { crumbs: [] }) %>

<section class="hero">
  <div class="hero-content">
    <span class="hero-eyebrow">Tampa's Trusted Dealership</span>
    <h1>Premium Used Cars,<br><span>Honest Prices.</span></h1>
    <p>Shop quality pre-owned Toyotas, Hondas, BMWs and more. Every vehicle inspected, every deal transparent.</p>
    <div class="hero-actions">
      <a href="#inventory" class="btn-primary">Browse Inventory &rarr;</a>
      <a href="/contact" class="btn-secondary">Schedule a Visit</a>
    </div>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path d="M0,80 L0,30 Q360,80 720,30 Q1080,-20 1440,30 L1440,80Z" fill="var(--bg)"/>
    </svg>
  </div>
</section>

<div class="trust-bar">
  <div class="trust-bar-inner">
    <div class="trust-item">
      <div class="trust-icon">&#128663;</div>
      <div class="trust-text"><strong><%= cars.length %>+ Vehicles</strong><span>In stock & ready to drive</span></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">&#128205;</div>
      <div class="trust-text"><strong>Tampa, FL</strong><span>Locally owned dealership</span></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">&#9989;</div>
      <div class="trust-text"><strong>Quality Checked</strong><span>Multi-point inspection</span></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon">&#128176;</div>
      <div class="trust-text"><strong>Easy Financing</strong><span>All credit welcome</span></div>
    </div>
  </div>
</div>

<div class="section" id="inventory">
  <div class="section-split">
    <div>
      <h2>Our Popular Cars</h2>
    </div>
    <div>
      <p>Handpicked vehicles at competitive prices. Find your perfect match from our curated selection.</p>
    </div>
  </div>
  <div class="filters">
    <button class="filter-btn active" onclick="setFilter('All')">All</button>
    <% makes.forEach(m => { %>
      <button class="filter-btn" onclick="setFilter('<%= m.make %>')"><%= m.make %></button>
    <% }) %>
  </div>
  <div class="car-grid" id="car-grid">
    <% if (cars.length === 0) { %>
      <div class="no-cars"><h3>Check back soon!</h3><p>We're updating our selection of quality vehicles.</p></div>
    <% } else { %>
      <% cars.forEach(car => { %>
        <%- include('../partials/car-card', { car, helpers }) %>
      <% }) %>
    <% } %>
  </div>
</div>

<section class="why-us">
  <div class="section">
    <div class="section-split">
      <div>
        <h2>Why Tampa<br>Autohaus?</h2>
      </div>
      <div>
        <p>We believe buying a car should be exciting, not stressful. Here's what sets us apart.</p>
      </div>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#128663;</div>
        <h3>Quality Vehicles</h3>
        <p>Every car passes a rigorous multi-point inspection before hitting our lot.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128176;</div>
        <h3>Fair Pricing</h3>
        <p>Competitive, transparent pricing. No hidden fees — what you see is what you pay.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#129309;</div>
        <h3>Zero Pressure</h3>
        <p>Take your time, ask questions, test drive. No pushy salespeople here.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128206;</div>
        <h3>Flexible Finance</h3>
        <p>We work with multiple lenders to find the right plan for your budget.</p>
      </div>
    </div>
  </div>
</section>

<div class="section">
  <div class="section-split">
    <div>
      <h2>Browse by Category</h2>
    </div>
    <div>
      <a href="/browse" class="section-link">View All Categories &rarr;</a>
    </div>
  </div>
  <div class="car-grid" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px;">
    <% makes.forEach(m => { %>
      <a href="<%= helpers.makeUrl(m.make) %>" class="browse-card">
        <strong><%= m.make %></strong>
        <span>Shop Used <%= m.make %></span>
      </a>
    <% }) %>
    <% bodyStyles.forEach(bs => { %>
      <a href="<%= helpers.bodyStyleUrl(bs.body_style) %>" class="browse-card">
        <strong><%= bs.body_style %>s</strong>
        <span>Shop Used <%= bs.body_style %>s</span>
      </a>
    <% }) %>
  </div>
</div>

<section class="cta">
  <h2>Ready to Drive Home<br>Your Next Car?</h2>
  <p>Visit us in Tampa or give us a call. No appointment needed — walk-ins always welcome.</p>
  <div class="hero-actions" style="justify-content:center;">
    <a href="/contact" class="btn-primary">Get in Touch &rarr;</a>
    <a href="tel:" class="btn-secondary">Call Us Now</a>
  </div>
</section>

<script>
  const allCards = document.querySelectorAll('#car-grid .car-card');
  function setFilter(make) {
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.classList.toggle('active', btn.textContent === make);
    });
    allCards.forEach(card => {
      if (make === 'All') { card.style.display = ''; return; }
      const title = card.querySelector('h3')?.textContent || '';
      card.style.display = title.includes(make) ? '' : 'none';
    });
  }
</script>
