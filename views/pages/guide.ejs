<%- include('../partials/breadcrumb', { crumbs }) %>

<section class="hero" style="padding:56px 32px 72px;">
  <div class="hero-content">
    <h1><%= content.h1 %></h1>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
      <path d="M0,60 L0,20 Q360,60 720,20 Q1080,-20 1440,20 L1440,60Z" fill="var(--light)"/>
    </svg>
  </div>
</section>

<div class="content-page">
  <div class="seo-content-block">
    <%- content.content %>
  </div>

  <% if (typeof matchingCars !== 'undefined' && matchingCars.length > 0) { %>
    <div class="section-header" style="text-align:left;margin:48px 0 24px;">
      <h2 style="font-size:1.5rem;">Browse Our Inventory</h2>
    </div>
    <div class="car-grid">
      <% matchingCars.slice(0, 6).forEach(car => { %>
        <%- include('../partials/car-card', { car, helpers }) %>
      <% }) %>
    </div>
  <% } %>

  <%- include('../partials/faq-section', { faqs: content.faqs }) %>
</div>

<section class="cta">
  <h2>Find Your Perfect Car at Tampa Autohaus</h2>
  <p>Browse our full inventory or contact us for personalized recommendations.</p>
  <div class="hero-actions" style="justify-content:center;">
    <a href="/inventory" class="btn-primary">Browse Inventory</a>
    <a href="/contact" class="btn-outline" style="background:transparent;color:white;border-color:rgba(255,255,255,0.3);">Contact Us</a>
  </div>
</section>
