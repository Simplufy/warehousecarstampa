<section class="contact-hero">
  <h1>Get in <span>Touch</span></h1>
  <p>Have a question or ready for a test drive? Reach out and we'll get back to you fast.</p>
</section>

<div class="contact-page">
  <div class="form-card">
    <h2>Send Us a Message</h2>
    <div id="form-msg" class="form-msg"></div>
    <div id="car-interest-box"></div>
    <form id="contact-form">
      <div class="form-row">
        <div class="form-group"><label>Your Name *</label><input type="text" id="name" required placeholder="John Smith"></div>
        <div class="form-group"><label>Phone Number</label><input type="tel" id="phone" placeholder="(555) 123-4567"></div>
      </div>
      <div class="form-group"><label>Email Address *</label><input type="email" id="email" required placeholder="john@example.com"></div>
      <div class="form-group"><label>What can we help you with? *</label><textarea id="message" required placeholder="I'm interested in scheduling a test drive..."></textarea></div>
      <input type="hidden" id="car_interest" value="">
      <button type="submit" class="submit-btn" id="submit-btn">Send Message</button>
    </form>
  </div>
  <div class="contact-sidebar">
    <div class="sidebar-card">
      <h3>Contact Info</h3>
      <div class="contact-item"><span class="contact-icon">&#128222;</span><div class="contact-text"><strong>Phone</strong><a href="tel:">Call us</a></div></div>
      <div class="contact-item"><span class="contact-icon">&#128205;</span><div class="contact-text"><strong>Location</strong>Tampa, FL</div></div>
      <div class="contact-item"><span class="contact-icon">&#9993;</span><div class="contact-text"><strong>Email</strong>info@floridaautohaus.com</div></div>
    </div>
    <div class="sidebar-card">
      <h3>Business Hours</h3>
      <table class="hours-table">
        <tr><td>Monday - Friday</td><td>9:00 AM - 6:00 PM</td></tr>
        <tr><td>Saturday</td><td>9:00 AM - 5:00 PM</td></tr>
        <tr><td>Sunday</td><td>Closed</td></tr>
      </table>
    </div>
    <div class="sidebar-card"><h3>Visit Us</h3><div class="map-placeholder">Map coming soon</div></div>
  </div>
</div>

<script>
  const params = new URLSearchParams(window.location.search);
  const carInterest = params.get('car');
  if (carInterest) {
    document.getElementById('car_interest').value = carInterest;
    document.getElementById('car-interest-box').innerHTML = '<div class="car-interest-banner">Inquiring about: ' + carInterest + '</div>';
    document.getElementById('message').placeholder = "I'm interested in the " + carInterest + ". Is it still available?";
  }
  document.getElementById('contact-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submit-btn');
    const msgEl = document.getElementById('form-msg');
    btn.disabled = true; btn.textContent = 'Sending...';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: document.getElementById('name').value, email: document.getElementById('email').value, phone: document.getElementById('phone').value, message: document.getElementById('message').value, car_interest: document.getElementById('car_interest').value })
      });
      const data = await res.json();
      if (res.ok) { msgEl.textContent = "Thank you! We'll get back to you as soon as possible."; msgEl.className = 'form-msg form-msg-success'; document.getElementById('contact-form').reset(); btn.textContent = 'Message Sent!'; }
      else { throw new Error(data.error); }
    } catch (err) { msgEl.textContent = err.message || 'Something went wrong. Please try again or give us a call.'; msgEl.className = 'form-msg form-msg-error'; btn.disabled = false; btn.textContent = 'Send Message'; }
  });
</script>
