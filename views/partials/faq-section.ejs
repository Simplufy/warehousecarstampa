<% if (typeof faqs !== 'undefined' && faqs && faqs.length) { %>
<section class="faq-section">
  <h2>Frequently Asked Questions</h2>
  <div class="faq-list">
    <% faqs.forEach(faq => { %>
      <details class="faq-item">
        <summary class="faq-question"><%= faq.q %></summary>
        <div class="faq-answer"><p><%= faq.a %></p></div>
      </details>
    <% }) %>
  </div>
</section>
<% } %>
